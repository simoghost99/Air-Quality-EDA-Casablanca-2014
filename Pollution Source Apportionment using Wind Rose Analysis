# 3. DETAILED SECTOR ANALYSIS
print("\n3. DETAILED SECTOR ANALYSIS")
print("-" * 40)

# Define sectors for detailed analysis
sectors = {
    'N': [337.5, 22.5],
    'NE': [22.5, 67.5],
    'E': [67.5, 112.5],
    'SE': [112.5, 157.5],
    'S': [157.5, 202.5],
    'SW': [202.5, 247.5],
    'W': [247.5, 292.5],
    'NW': [292.5, 337.5]
}

def get_sector(degrees):
    """Convert degrees to sector"""
    for sector, (min_deg, max_deg) in sectors.items():
        if min_deg <= degrees < max_deg:
            return sector
    return 'N'  # Default for 0 degrees

df_wind['sector'] = df_wind['WD_degrees'].apply(get_sector)

# Analyze pollution by sector
print("\nPOLLUTION BY WIND SECTOR:")
for pollutant in pollutants:
    if pollutant in df_wind.columns:
        sector_stats = df_wind.groupby('sector')[pollutant].agg(['mean', 'count', 'max']).round(2)
        max_sector = sector_stats['mean'].idxmax()
        max_value = sector_stats['mean'].max()
        min_sector = sector_stats['mean'].idxmin()
        min_value = sector_stats['mean'].min()
        
        print(f"\n{pollutant}:")
        print(f"  Highest concentrations from: {max_sector} ({max_value} {pollutant_units[pollutant]})")
        print(f"  Lowest concentrations from: {min_sector} ({min_value} {pollutant_units[pollutant]})")
        
        # Print top 3 sectors
        top_sectors = sector_stats.nlargest(3, 'mean')
        print(f"  Top 3 sectors:")
        for sector, row in top_sectors.iterrows():
            print(f"    {sector}: {row['mean']} {pollutant_units[pollutant]} ({row['count']} hours)")

